# Application Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Eagle Investors Admin Dashboard

# API Configuration
NEXT_PUBLIC_API_URL=https://eagleinvest.us/api

# JWT Configuration (must match backend)
JWT_SECRET=JKJDhayyhnc_PRODUCTION_CHANGE_ME

# ============================================================
# Admin Dashboard Configuration
# ============================================================
NEXT_PUBLIC_ADMIN_DASHBOARD_URL=https://admin.eagleinvest.us
NEXT_PUBLIC_FRONTEND_URL=https://eagleinvest.us

# Business Information
NEXT_PUBLIC_BUSINESS_NAME=Eagle Investors
NEXT_PUBLIC_BUSINESS_EMAIL=support@eagleinvest.us

# ============================================================
# Payment Gateway Visibility (Read-Only for Admin)
# ============================================================
NEXT_PUBLIC_STRIPE_DASHBOARD_URL=https://dashboard.stripe.com
NEXT_PUBLIC_PAYPAL_DASHBOARD_URL=https://www.paypal.com/businessmanage

# Security
NEXTAUTH_URL=https://admin.eagleinvest.us
NEXTAUTH_SECRET=YOUR_STRONG_ADMIN_NEXTAUTH_SECRET_HERE

# Database
NEXT_PUBLIC_DATABASE_NAME=eagle

# ============================================================
# Admin Features
# ============================================================
NEXT_PUBLIC_ENABLE_ADMIN_LOGS=true
NEXT_PUBLIC_ENABLE_USER_MANAGEMENT=true
NEXT_PUBLIC_ENABLE_SUBSCRIPTION_MANAGEMENT=true
NEXT_PUBLIC_ENABLE_TRANSACTION_LOGS=true
NEXT_PUBLIC_ENABLE_ANALYTICS_DASHBOARD=true

# ============================================================
# Monitoring & Analytics
# ============================================================
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true

# ============================================================
# Export & Reporting
# ============================================================
NEXT_PUBLIC_ENABLE_DATA_EXPORT=true
NEXT_PUBLIC_ENABLE_PDF_REPORTS=true
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dirdbnxe1
